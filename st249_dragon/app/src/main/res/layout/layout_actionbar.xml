<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/transparent">

    <!--    btnActionBarLeft-->
    <ImageView
        android:id="@+id/btnActionBarLeft"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



    <!--    btnActionBarLeft-->
    <ImageView
        android:id="@+id/btnReset"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--    cvLogo-->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvLogo"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--        imvLogo-->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_logo" />
    </androidx.cardview.widget.CardView>



    <ImageView
        android:id="@+id/spTvStart"
        android:layout_width="204dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_light"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tvStart"
        app:layout_constraintBottom_toBottomOf="@id/tvStart"
        app:layout_constraintStart_toStartOf="@id/tvStart"
        app:layout_constraintEnd_toEndOf="@id/tvStart"
        android:layout_marginTop="35dp"
        />

    <!--    tvStart-->
    <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvStart"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_marginHorizontal="0dp"
        android:fontFamily="@font/copperplategothic_bold"
        android:gravity="center"
        android:text="@string/language"
        android:layout_marginStart="20dp"
        android:textColor="@color/app"
        android:textSize="28sp"
        tools:visibility="visible"
        app:outerStrokeColor="#2B1A00"
        android:visibility="gone"
        android:shadowColor="@color/app2"
        android:shadowDy="3"
        android:shadowRadius=".1"
        app:outerStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />



    <ImageView
        android:id="@+id/spTvCenter"
        android:layout_width="204dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_light"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@id/tvCenter"
        app:layout_constraintBottom_toBottomOf="@id/tvCenter"
        app:layout_constraintStart_toStartOf="@id/tvCenter"
        app:layout_constraintEnd_toEndOf="@id/tvCenter"
        android:layout_marginTop="20dp"
        />

    <!--    tvCenter-->
    <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
    android:id="@+id/tvCenter"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="70dp"
        android:fontFamily="@font/copperplategothic_bold"
        android:gravity="center"
        tools:text="@string/my_work"
        android:text="@string/language"
        android:textColor="@color/app"
        android:textSize="28sp"
        android:visibility="gone"
        tools:visibility="visible"
        app:outerStrokeColor="#2B1A00"
        app:outerStrokeWidth="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />



    <!--    tvCenter-->
    <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
        android:id="@+id/tvCenter1"
        style="@style/single_marquee"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_marginHorizontal="100dp"
        android:fontFamily="@font/copperplategothic_bold"
        android:gravity="center"
        android:text="@string/language"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    tvCenter-->
    <ImageView
        android:id="@+id/imgCenter"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center"
        android:textSize="24sp"
        android:scaleType="fitXY"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarNextRight"
        app:layout_constraintStart_toEndOf="@+id/btnActionBarLeft"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionBarCenter"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="@id/guideline"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionBarCenterLeft"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        tools:visibility="visible"
        android:src="@drawable/ic_reset"
        app:layout_constraintHorizontal_bias="0.65"
        app:layout_constraintStart_toEndOf="@id/btnActionBarLeft"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="@id/guideline"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    btnActionBarCenterRight-->
    <ImageView
        android:id="@+id/btnActionBarCenterRight"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        tools:visibility="visible"
        android:src="@drawable/ic_flip"
        app:layout_constraintHorizontal_bias="0.35"
        app:layout_constraintEnd_toStartOf="@id/btnActionBarRight"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />

    <!--    btnActionBarNextRight-->
    <ImageView
        android:id="@+id/btnActionBarNextRight"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        tools:visibility="visible"
        tools:src="@drawable/ic_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnActionBarRight" />

    <!--    btnActionBarRight-->
    <ImageView
        android:id="@+id/btnActionBarRight"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        android:src="@drawable/ic_next"
        tools:visibility="visible"

        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />



    <!--    btnActionBarNextRight-->
    <ImageView
        android:id="@+id/btnActionBarNextRight1"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginEnd="-10dp"
        android:layout_marginBottom="10dp"
        tools:visibility="visible"
        tools:src="@drawable/ic_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnActionBarRight" />

    <!--    btnActionBarRight-->
    <ImageView
        android:id="@+id/btnActionBarRight1"
        android:layout_width="69dp"
        android:layout_height="69dp"
        android:scaleType="fitXY"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        android:src="@drawable/ic_next"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />



    <!--    btnActionBarRight-->
    <ImageView
        android:id="@+id/btnActionBarRightLang"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        tools:src="@drawable/ic_done"
        tools:visibility="visible"

        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarNextRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarNextRight" />

    <!--    btnShare-->
    <ImageView
        android:id="@+id/btnShare"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share_ss"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--            btnActionBarRightText-->
    <FrameLayout
        android:id="@+id/btnActionBarRightText"
        android:layout_width="70dp"
        android:layout_height="39dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_btnactionbarrighttext"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarRight">

        <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
            android:id="@+id/tvRightText"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="5dp"
            android:fontFamily="@font/copperplategothic_bold"
            android:gravity="center"
            app:outerStrokeWidth="2dp"
            app:outerStrokeColor="@color/app1"
            android:text="@string/next"
            android:visibility="invisible"
            android:textColor="@color/app"
            android:textSize="16sp" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"
        android:id="@+id/guideline"
        />
</androidx.constraintlayout.widget.ConstraintLayout>