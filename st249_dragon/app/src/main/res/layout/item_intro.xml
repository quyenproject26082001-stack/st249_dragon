<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/imvImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvContent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="fitXY"
        android:src="@drawable/img_intro_1" />

    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="68sp"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/copperplategothic_bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:outerStrokeColor="@color/app1"
        android:shadowColor="@color/app2"
        app:outerStrokeWidth="1dp"
        android:shadowDy="3"
        android:shadowRadius=".1"

        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>