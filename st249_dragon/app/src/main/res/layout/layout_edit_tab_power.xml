<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlPower"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/copperplategothic_bold"
        android:shadowColor="@color/app2"
        android:shadowDy="3"
        android:shadowRadius=".1"
        android:text="@string/star_rating"
        android:textColor="@color/app"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp" />

    <LinearLayout
        android:id="@+id/btnRatingStar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7"
        app:layout_constraintTop_toBottomOf="@id/tvStar">

        <ImageView
            android:id="@+id/btnStar1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_slt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_slt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar6"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStar7"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

    </LinearLayout>


    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/copperplategothic_bold"
        android:shadowColor="@color/app2"
        android:shadowDy="3"
        android:shadowRadius=".1"
        android:text="@string/star_style"
        android:textColor="@color/app"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRatingStar"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp" />

    <LinearLayout
        android:id="@+id/btnStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7"
        app:layout_constraintTop_toBottomOf="@id/tvStyle">

        <ImageView
            android:id="@+id/btnStarStyle1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_slt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_slt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle6"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnStarStyle7"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_1_uslt"
            android:layout_weight="1" />

    </LinearLayout>

    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvEditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/copperplategothic_bold"
        android:shadowColor="@color/app2"
        android:shadowDy="3"
        android:shadowRadius=".1"
        android:text="@string/satistics"
        android:textColor="@color/app"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRatingStar"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp" />


    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:id="@+id/tvSatistics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/copperplategothic_bold"
        android:shadowColor="@color/app2"
        android:shadowDy="3"
        android:shadowRadius=".1"
        android:text="@string/satistics"
        android:textColor="@color/app"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnStyle"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_atk"
        app:layout_constraintTop_toTopOf="@id/tvAtk"
        app:layout_constraintBottom_toBottomOf="@id/tvAtk"
        app:layout_constraintEnd_toStartOf="@+id/tvAtk"
        />

    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATK/ ?"
        android:textColor="@color/white"
        android:shadowRadius=".1"
        android:shadowDy="3"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvSatistics"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias=".3"
        android:fontFamily="@font/copperplategothic_bold"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp"
        android:id="@+id/tvAtk"
        />

    <


    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_def"
        app:layout_constraintTop_toTopOf="@id/tvDef"
        app:layout_constraintBottom_toBottomOf="@id/tvDef"
        app:layout_constraintEnd_toStartOf="@+id/tvDef"
        />
    <com.female.maker.oc.creator2.core.custom.text.OuterStrokeTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEF/ ?"
        android:textColor="@color/white"
        android:shadowRadius=".1"
        android:shadowDy="3"
        app:layout_constraintTop_toTopOf="@id/tvAtk"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias=".8"
        android:fontFamily="@font/copperplategothic_bold"
        app:outerStrokeColor="@color/app1"
        app:outerStrokeWidth=".5dp"
        android:id="@+id/tvDef"
        />
    
    <EditText
        android:layout_width="100dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvAtk"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/tvAtk"
        app:layout_constraintEnd_toEndOf="@id/tvAtk"/>

    <EditText
        android:layout_width="100dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvDef"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/tvDef"
        app:layout_constraintEnd_toEndOf="@id/tvDef"/>


</androidx.constraintlayout.widget.ConstraintLayout>
