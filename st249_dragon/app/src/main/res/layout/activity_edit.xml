<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.add_character.AddCharacterActivity">

    <!--    flGetText-->
    <FrameLayout
        android:id="@+id/flGetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:paddingHorizontal="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="5dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--        tvGetText-->
        <TextView
            android:id="@+id/tvGetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:maxLength="30"
            android:text=""
            android:textColor="@color/black"
            android:textSize="40sp" />
    </FrameLayout>


    <!--    flActionBar-->
    <FrameLayout
        android:id="@+id/flActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardCaptureContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="39dp"
        android:layout_marginTop="0dp"
        android:clipChildren="false"
        android:clipToOutline="false"
        app:layout_constraintBottom_toTopOf="@id/gl"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintDimensionRatio="735:1072"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flActionBar"
        tools:background="@drawable/bg_tools"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTitleStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.07" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTitleEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.93" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTitleTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDragonStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.105" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDragonEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.895" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDragonTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.174" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDragonBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.713" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDescStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.073" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDescEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.929" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDescTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.748" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDescBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.948" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bgImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:elevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/guideDragonBottom"
            app:layout_constraintEnd_toStartOf="@id/guideDragonEnd"
            app:layout_constraintStart_toStartOf="@id/guideDragonStart"
            app:layout_constraintTop_toTopOf="@id/guideDragonTop"
            tools:background="@color/app1">

            <ImageView
                android:id="@+id/imvBgImageAsset"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--    flSave-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bgTag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToOutline="false">

        <ImageView
            android:id="@+id/imvBgTagAsset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="@id/bgTag"
            app:layout_constraintStart_toStartOf="@id/bgTag"
            app:layout_constraintTop_toTopOf="@id/bgTag"
            app:layout_constraintBottom_toTopOf="@id/guideDragonTop">

            <com.willy.ratingbar.ScaleRatingBar
                android:id="@+id/rbPreviewStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                app:srb_clearRatingEnabled="false"
                app:srb_clickable="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.15"
                app:layout_constraintVertical_bias="0.65"
                app:srb_drawableEmpty="@drawable/ic_star_transparent"
                app:srb_drawableFilled="@drawable/style1_small"
                app:srb_isIndicator="true"
                app:srb_minimumStars="0"
                app:srb_numStars="7"
                app:srb_rating="2"
                app:srb_scrollable="false"
                app:srb_starHeight="24dp"
                app:srb_starPadding="2dp"
                app:srb_starWidth="24dp"
                app:srb_stepSize="1" />
            
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/tvNameTag"
            tools:text="Name Tag"
            android:textColor="#2B1A00"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/guideTitleEnd"
            app:layout_constraintStart_toStartOf="@id/guideTitleStart"
            android:fontFamily="@font/copperplategothic_bold"
            app:layout_constraintTop_toTopOf="@id/guideTitleTop"
            />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="@id/bgImage"
            tools:visibility="visible"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-13dp"
            android:foreground="@drawable/ic_claws"
            app:layout_constraintEnd_toEndOf="@id/bgImage"
            app:layout_constraintStart_toStartOf="@id/bgImage"
            app:layout_constraintBottom_toBottomOf="@id/bgImage"
            />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToOutline="false"
            app:layout_constraintTop_toTopOf="@id/guideDescTop"
            app:layout_constraintBottom_toTopOf="@id/guideDescBottom"
            app:layout_constraintEnd_toStartOf="@id/guideDescEnd"
            app:layout_constraintStart_toStartOf="@id/guideDescStart"

            >

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideStatLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.78" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideAtkY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.8" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideDefY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.8" />

            <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvDescrible"
                tools:text="Immerse yourself aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaain a dark fantasy world where legend and technology intertwine, with this unique collection of six mesmerizing dragon part cards."
                android:textColor="#2B1A00"
                android:textSize="12sp"
                android:maxLines="3"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/afacadflux"
                app:layout_constraintTop_toTopOf="parent"
                />
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:src="@drawable/ic_line_edit"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="@id/guideStatLine"
                android:id="@+id/icLine"
                />


            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_atk"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="@id/tvAtk"
                app:layout_constraintBottom_toBottomOf="@id/tvAtk"
                app:layout_constraintEnd_toStartOf="@+id/tvAtk"
                />

            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvAtk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATK/ ?"
                app:layout_constraintTop_toTopOf="@id/guideAtkY"
                android:textColor="@color/black"
                android:visibility="visible"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias=".67"
                android:fontFamily="@font/copperplategothic_bold"
                app:outerStrokeColor="@color/transparent"
                />


            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:visibility="invisible"
                android:src="@drawable/ic_def"
                app:layout_constraintTop_toTopOf="@id/tvDef"
                app:layout_constraintBottom_toBottomOf="@id/tvDef"
                app:layout_constraintEnd_toStartOf="@+id/tvDef"
                />
            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEF/ ?"
                app:layout_constraintTop_toTopOf="@id/guideDefY"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="1"
                android:fontFamily="@font/copperplategothic_bold"
                android:id="@+id/tvDef"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!--    flFunction-->
    <FrameLayout
        android:id="@+id/flFunction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="17dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toTopOf="@id/lnlBottom"
        app:layout_constraintTop_toBottomOf="@id/gl">

        <include
            android:id="@+id/tabNameTag"
            layout="@layout/layout_edit_tab_nametag" />

        <include
            android:id="@+id/tabPower"
            layout="@layout/layout_edit_tab_power" />

        <include
            android:id="@+id/tabBg"
            layout="@layout/layout_edit_tab_bg" />

        <include
            android:id="@+id/tabDescribe"
            layout="@layout/layout_edit_tab_describe" />
    </FrameLayout>

    <!--    lnlBottom-->
    <LinearLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#F1E2AF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnNameTag"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icHead"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_nametag" />

            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvNameTagTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name_tag"
                android:layout_marginTop="-10dp"
                android:textColor="@color/white"
                app:outerStrokeColor="#2B1A00"
                app:outerStrokeWidth="1dp"
                android:fontFamily="@font/copperplategothic_bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPower"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icTorso"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_power" />

            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvPowerTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/copperplategothic_bold"
                android:text="@string/power"
                android:layout_marginTop="-10dp"

                android:textColor="@color/white"
                app:outerStrokeColor="#2B1A00"
                app:outerStrokeWidth="1dp"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icLegs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_bg" />

            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvBgTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bg"
                android:textColor="@color/white"
                android:layout_marginTop="-10dp"
                app:outerStrokeColor="#2B1A00"
                app:outerStrokeWidth="1dp"
                android:fontFamily="@font/copperplategothic_bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDescrible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icWings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_des" />

            <com.dragon.oc.avatar.creator.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvDescribeTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/describe"
                android:textColor="@color/white"
                android:layout_marginTop="-10dp"
                app:outerStrokeColor="#2B1A00"
                app:outerStrokeWidth="1dp"
                android:fontFamily="@font/copperplategothic_bold"
                android:textSize="14sp" />
        </LinearLayout>



    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/blue_app"
        app:layout_constraintBottom_toTopOf="@id/lnlBottom"
        app:layout_constraintTop_toBottomOf="@id/flFunction" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.63" />

    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
    <!--    <FrameLayout-->
    <!--        android:id="@+id/flNativeCollab"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent">-->

    <!--    </FrameLayout>-->

    <!--    &lt;!&ndash; Custom Input View (1/4 screen height) &ndash;&gt;-->
    <!--    <include-->
    <!--        android:id="@+id/customInputLayout"-->
    <!--        layout="@layout/layout_custom_input"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0dp"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent"-->
    <!--        app:layout_constraintHeight_percent="0.25" />-->

</androidx.constraintlayout.widget.ConstraintLayout>
