<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home"
        android:scaleType="centerCrop" />

    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gLH"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".54" />

    <!--    scvMain-->
    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-10dp"
        android:layout_marginBottom="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gLH">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp">

            <FrameLayout
                android:id="@+id/btnMaker"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginHorizontal="16dp"
                android:adjustViewBounds="true"
                android:background="@drawable/img_home_1"
                app:layout_constraintTop_toTopOf="parent">

                <!--            tv2-->
                <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
                    android:id="@+id/tv1"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:fontFamily="@font/copperplategothic_bold"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/dragon_custom"
                    android:textColor="@color/app"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMaker"
                    app:layout_constraintEnd_toEndOf="@+id/btnMaker"
                    app:layout_constraintStart_toStartOf="@id/btnMaker"
                    app:layout_constraintTop_toTopOf="@+id/btnMaker"
                    app:outerStrokeColor="@color/app1"
                    android:shadowColor="@color/app2"
                    app:outerStrokeWidth="1dp"
                    android:shadowDy="3"
                    android:shadowRadius=".1" />

            </FrameLayout>


            <FrameLayout
                android:id="@+id/btnRandom"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="16dp"
                android:adjustViewBounds="true"
                android:background="@drawable/img_home_1"
                app:layout_constraintTop_toBottomOf="@id/btnMaker"
                >

                <!--            tv2-->
                <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
                    android:id="@+id/tv2"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:fontFamily="@font/copperplategothic_bold"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/random_dragon"
                    android:textColor="@color/app"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMaker"
                    app:layout_constraintEnd_toEndOf="@+id/btnMaker"
                    app:layout_constraintStart_toStartOf="@id/btnMaker"
                    app:layout_constraintTop_toTopOf="@+id/btnMaker"
                    app:outerStrokeColor="@color/app1"
                    android:shadowColor="@color/app2"
                    app:outerStrokeWidth="1dp"
                    android:shadowDy="3"
                    android:shadowRadius=".1"/>

            </FrameLayout>


            <FrameLayout
                android:id="@+id/btnMyCreation"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="16dp"
                android:adjustViewBounds="true"
                android:background="@drawable/img_home_1"
                app:layout_constraintTop_toBottomOf="@id/btnRandom"
                >

                <!--            tv2-->
                <com.dragon.oc.avatar.creator.core.custom.text.OuterStrokeTextView
                    android:id="@+id/tv3"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:fontFamily="@font/copperplategothic_bold"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/my_creation"
                    android:textColor="@color/app"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMaker"
                    app:layout_constraintEnd_toEndOf="@+id/btnMaker"
                    app:layout_constraintStart_toStartOf="@id/btnMaker"
                    app:layout_constraintTop_toTopOf="@+id/btnMaker"
                    app:outerStrokeColor="@color/app1"
                    android:shadowColor="@color/app2"
                    app:outerStrokeWidth="1dp"
                    android:shadowDy="3"
                    android:shadowRadius=".1" />

            </FrameLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!--    flNativeCollab-->
    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"></FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>